# Frontend (Vite): empty string = same-origin / dev proxy. For Netlify, set to your API origin at build time.
VITE_API_BASE=http://127.0.0.1:8000

# Backend (FastAPI): comma-separated browser origins allowed to call the API (add your Netlify URL in production).
# MALONE_CORS_ORIGINS=https://your-site.netlify.app

# Demo readiness (optional): tighten UI presentation and limit web search on conversational renders.
# MALONE_DEMO_MODE=1
# MALONE_DEMO_SAFE_RESPONSES=1
# MALONE_DEMO_LIMITED_SCOPE=1
