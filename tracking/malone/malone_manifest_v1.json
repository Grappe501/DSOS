    {
      "id": "stage_9_multi_agent_system",
      "status": "planned",
      "implement_now": false,
      "objective": "bounded subordinate agents and watchers"
    },
    {
      "id": "stage_10_voice_runtime",
      "status": "planned",
      "implement_now": false,
      "objective": "voice-first governed operational runtime"
    },
    {
      "id": "stage_11_local_model_path",
      "status": "planned",
      "implement_now": false,
      "objective": "local-model abstraction for GPU transition"
