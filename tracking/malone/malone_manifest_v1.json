      "status": "planned",
      "implement_now": false,
      "objective": "ground Malone in internal DSOS knowledge before broad web power"
    },
    {
      "id": "stage_4_web_retrieval",
      "status": "implemented",
      "implement_now": false,
      "objective": "allow current-information answers with evidence control"
