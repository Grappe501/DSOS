{
  "version": "v1.1",
  "system": "malone",
  "doctrine": {
    "ai_proposes_only": true,
    "deterministic_validation_required": true,
    "server_side_llm_only": true,
    "render_verification_required": true,
    "approval_required_for_writes": true
  },
  "current_baseline": {
    "implemented": [
      "intent_classification",
      "proposal_envelope_generation",
      "deterministic_validation",
      "safe_schedule_read_execution",
      "safe_schedule_analysis_execution",
      "proposal_persistence",
      "proposal_lifecycle_audit",
      "proposal_history_ui"
    ],
    "next_slice": "stage_1_conversational_rendering"
  },
  "stages": [
    {
      "id": "stage_1_conversational_rendering",
      "status": "next",
      "implement_now": true,
      "objective": "convert deterministic results into conversational responses without fact drift",
      "deliverables": [
        "openai_service",
        "truth_packet_schema",
        "render_service",
        "render_verifier",
        "render_audit_events",
        "ui_conversational_answer_panel",
        "fallback_plain_response"
      ],
      "safety_gates": [
        "OPENAI_API_KEY remains backend-only",
        "structured outputs only for governed render responses",
        "every rendered answer verified against truth packet",
        "fallback deterministic response on verification failure",
        "no regression to auth schedules or proposal persistence"
      ]
    },
    {
      "id": "stage_2_clarification_loop",
      "status": "planned",
      "implement_now": false,
      "objective": "ask targeted questions when request ambiguity blocks safe execution",
      "deliverables": [
        "ambiguity_detector",
        "clarification_schema",
        "pending_clarification_state",
        "clarification_audit_events"
      ],
      "depends_on": [
        "stage_1_conversational_rendering"
      ]
    },
    {
      "id": "stage_3_internal_retrieval",
      "status": "planned",
      "implement_now": false,
      "objective": "ground Malone in internal DSOS knowledge before broad web power",
      "deliverables": [
        "internal_retrieval_service",
        "evidence_packet_model",
        "source_aware_responses",
        "retrieval_audit"
      ],
      "depends_on": [
        "stage_2_clarification_loop"
      ]
    },
    {
      "id": "stage_4_web_retrieval",
      "status": "planned",
      "implement_now": false,
      "objective": "allow current-information answers with evidence control",
      "deliverables": [
        "web_retrieval_service",
        "domain_policy_rules",
        "web_evidence_packet",
        "citation_required_modes"
      ],
      "depends_on": [
        "stage_3_internal_retrieval"
      ]
    },
    {
      "id": "stage_5_approval_foundation",
      "status": "planned",
      "implement_now": false,
      "objective": "govern transition from proposals to write-capable execution",
      "deliverables": [
        "approval_request_model",
        "approval_queue",
        "approve_reject_routes",
        "approval_ui"
      ],
      "depends_on": [
        "stage_4_web_retrieval"
      ]
    },
    {
      "id": "stage_6_governed_write_execution",
      "status": "planned",
      "implement_now": false,
      "objective": "execute bounded approved state changes through deterministic registries",
      "deliverables": [
        "action_registry",
        "preflight_validation",
        "post_execution_audit",
        "department_scope_enforcement"
      ],
      "depends_on": [
        "stage_5_approval_foundation"
      ]
    },
    {
      "id": "stage_7_tool_orchestration",
      "status": "planned",
      "implement_now": false,
      "objective": "coordinate governed use of internal and external tools",
      "deliverables": [
        "tool_registry",
        "tool_capability_manifest",
        "tool_policy_layer",
        "tool_run_logging"
      ],
      "depends_on": [
        "stage_6_governed_write_execution"
      ]
    },
    {
      "id": "stage_8_multi_agent_system",
      "status": "planned",
      "implement_now": false,
      "objective": "supervise specialist agents without losing deterministic control",
      "deliverables": [
        "agent_registry",
        "agent_contracts",
        "agent_run_persistence",
        "supervisor_review"
      ],
      "depends_on": [
        "stage_7_tool_orchestration"
      ]
    },
    {
      "id": "stage_9_voice_runtime",
      "status": "planned",
      "implement_now": false,
      "objective": "support safe voice-first operation",
      "deliverables": [
        "speech_input_pipeline",
        "spoken_response_mode",
        "high_risk_confirmation_flow"
      ],
      "depends_on": [
        "stage_8_multi_agent_system"
      ]
    },
    {
      "id": "stage_10_local_model_path",
      "status": "planned",
      "implement_now": false,
      "objective": "prepare for future GPU-hosted and hybrid model deployment",
      "deliverables": [
        "model_abstraction_layer",
        "benchmark_harness",
        "local_adapter_interface",
        "proposal_based_self_improvement"
      ],
      "depends_on": [
        "stage_9_voice_runtime"
      ]
    }
  ]
}